# Switch backend here: ollama | anthropic | openai
LLM_PROVIDER=ollama

# Shared temperature (0 = deterministic tool calling)
LLM_TEMPERATURE=0

# --- Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b
LLM_MODEL=llama3.2:1b
OLLAMA_KEEP_ALIVE=5m

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# Paste your key ONLY in .env (this file is safe to commit — placeholder only).
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Entry mode: cli | voice
TARS_MODE=voice

# Whisper: base.en (fast English) | tiny.en | base | …
WHISPER_MODEL=base.en
HF_HUB_DISABLE_SYMLINKS_WARNING=1
