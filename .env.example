# Provider: openai | ollama
LLM_PROVIDER=openai

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (LLM_PROVIDER=ollama) ---
# Requires a running Ollama server with a tool-capable model, e.g.:
#   ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Entry mode: cli (default) | voice  (voice stub until PTT is re-enabled)
TARS_MODE=cli

# Voice stack (unused in CLI mode; kept for the future PTT loop)
# WHISPER_MODEL=base
